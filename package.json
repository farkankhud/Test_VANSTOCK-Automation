{
  "name": "scrum-8-vanstock-upload",
  "version": "1.0.0",
  "description": "SCRUM-8: Van Stock Profile mass upload (upload, returns, leavers)",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@sap/cds": "^8",
    "@cap-js/hana": "^1",
    "express": "^4",
    "@sap/xssec": "^4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^1",
    "@sap/cds-dk": "^8",
    "cds-plugin-ui5": "^0.17.0"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-vanstockupload": "cds watch --open scrum8.vanstockupload/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-vanstockprofiles": "cds watch --open scrum8.vanstockprofiles/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "cds": {
    "requires": {
      "db": {
        "[development]": {
          "kind": "sqlite",
          "credentials": {
            "url": ":memory:"
          }
        },
        "[production]": {
          "kind": "hana"
        }
      },
      "[production]": {
        "auth": "xsuaa",
        "db": {
          "kind": "hana"
        }
      }
    },
    "sql": {
      "native_hana_associations": false
    }
  },
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/vanstockupload",
    "app/vanstockprofiles"
  ]
}
